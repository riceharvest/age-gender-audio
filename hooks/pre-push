#!/usr/bin/env bash
# pre-push hook: privacy + hygiene scan of ONLY the commits being pushed.
#   1. commit messages must not carry AI attribution trailers (commit-msg strips
#      them at commit time; this is the backstop for --no-verify / imported commits).
#   2. added lines must not contain secrets (default pattern below).
#   3. optional: added lines must not match hygiene.forbiddenPattern (e.g. private
#      names/paths when a repo is public). Set it with:
#        git config hygiene.forbiddenPattern 'term1|term2|/home/someone'
# Config (env wins over git config): GIT_HYGIENE_AI_PATTERN, GIT_HYGIENE_SECRET_PATTERN,
# GIT_HYGIENE_FORBIDDEN_PATTERN. Install: git config core.hooksPath hooks
set -euo pipefail
remote="${1:-origin}"
ZERO=0000000000000000000000000000000000000000

ai_pattern="${GIT_HYGIENE_AI_PATTERN:-$(git config --get hygiene.aiPattern || true)}"
ai_pattern="${ai_pattern:-claude|anthropic|openai|chatgpt|gpt-[0-9]|codex|gemini|copilot|cursor|aider|devin|qwen|deepseek|llama|mistral|🤖}"
secret_pattern="${GIT_HYGIENE_SECRET_PATTERN:-$(git config --get hygiene.secretPattern || true)}"
secret_pattern="${secret_pattern:-sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|hf_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----}"
forbidden="${GIT_HYGIENE_FORBIDDEN_PATTERN:-$(git config --get hygiene.forbiddenPattern || true)}"

status=0
while read -r lref lsha rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue  # deleting a ref pushes nothing
  if [ "$rsha" = "$ZERO" ]; then
    if [ -n "$(git for-each-ref --count=1 "refs/remotes/$remote")" ]; then
      commits=$(git rev-list "$lsha" --not --remotes="$remote")
    else
      commits=$(git rev-list "$lsha" --not --remotes)
    fi
  else
    commits=$(git rev-list "$rsha..$lsha")
  fi
  for c in $commits; do
    msg=$(git log -1 --format=%B "$c")
    if printf '%s\n' "$msg" | grep -iE "^[[:space:]]*co-authored-by:.*($ai_pattern)" >/dev/null 2>&1; then
      echo "pre-push BLOCKED: commit $c carries an AI co-author trailer; amend/rebase it away."
      status=1
    fi
    added=$(git show --format= --unified=0 "$c" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
    if [ -n "$added" ]; then
      m=$(printf '%s\n' "$added" | grep -iE -n "$secret_pattern" || true)
      if [ -n "$m" ]; then
        echo "pre-push BLOCKED: commit $c adds what looks like a secret:"
        printf '%s\n' "$m" | head -n 10
        status=1
      fi
      if [ -n "$forbidden" ]; then
        m=$(printf '%s\n' "$added" | grep -iE -n "$forbidden" || true)
        if [ -n "$m" ]; then
          echo "pre-push BLOCKED: commit $c adds forbidden content:"
          printf '%s\n' "$m" | head -n 10
          status=1
        fi
      fi
    fi
  done
done
exit $status